apiVersion: v1
kind: Secret
metadata:
  name: energyleaf-postgres-secrets
  namespace: energyleaf
type: Opaque
stringData:
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "postgres"
  POSTGRES_DB: "energyleaf"
  # DATABASE_URL is optional - the app can construct it from POSTGRES_* vars above
  # Include it here if you want to provide a complete connection string directly
  # DATABASE_URL: "postgresql://postgres:postgres@energyleaf-db:5432/energyleaf"
