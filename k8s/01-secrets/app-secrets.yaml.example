apiVersion: v1
kind: Secret
metadata:
  name: energyleaf-app-secrets
  namespace: energyleaf
type: Opaque
stringData:
  CRON_SECRET: "replace-with-strong-random-secret"
  # Add other app secrets here as needed
  # NEXT_PUBLIC_* vars should NOT be here (they are public)
  # Only sensitive server-side secrets go here
